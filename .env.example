# Preenchida automaticamente ao conectar o Neon pela aba Storage da Vercel
DATABASE_URL=

# Token que você cadastra no webhook da Wiapy (header Authorization)
WIAPY_TOKEN=

# Senha do painel e segredo do cookie (texto longo e aleatório)
PAINEL_SENHA=
SESSION_SECRET=

# ---- Meta: Purchase pela API de Conversões ----
META_PIXEL_ID=1126461060235843
META_ACCESS_TOKEN=
# Coloque "false" para o rastreador NÃO enviar Purchase (se a Wiapy já envia)
META_CAPI_ATIVO=true
# Opcional: código da aba "Eventos de teste" (apague depois de testar)
META_TEST_EVENT_CODE=

# ---- Meta Ads: gasto, métricas e status das campanhas ----
# Uma ou mais contas, separadas por vírgula (com ou sem "act_")
META_AD_ACCOUNT_IDS=
# Token com permissão ads_read (ideal: usuário do sistema). Se vazio, usa META_ACCESS_TOKEN
META_ADS_TOKEN=

# ---- Opcionais ----
# Imposto sobre o faturamento bruto, em %, descontado do lucro (ex.: 6)
IMPOSTO_PCT=0
META_API_VERSION=v25.0
LANDING_URL=https://forma-tecnicoiphone.vercel.app/
